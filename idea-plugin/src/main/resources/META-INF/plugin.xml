<idea-plugin>
    <id>com.aicoding.ai-coding-plugin</id>
    <name>Capybara AI Coding Assistant</name>
    <vendor email="1270374419@qq.com" url="https://gitee.com/qianguanshui/capybaraAICodingAssistant">AI Coding Team</vendor>
    <description><![CDATA[
        A compact IntelliJ IDEA coding assistant powered by a local OpenCode server.
    ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <!-- Optional: only needed so the IDEA Maven runner bridge can resolve MavenRunner at runtime. -->
    <depends optional="true" config-file="capybara-maven.xml">org.jetbrains.idea.maven</depends>
    <!--
      JCEF module. IDEA 2025.3.1+ requires plugins that use com.intellij.ui.jcef to declare
      this dependency; the module does not exist in 2023.x-2025.2, so it must stay optional
      or the plugin would refuse to load on older IDEs.
    -->
    <depends optional="true" config-file="capybara-jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="水豚 AI 助手"
            factoryClass="com.aicoding.plugin.AICodingToolWindowFactory"
            icon="/Capybara.svg"
            anchor="right" />
    </extensions>

    <actions>
        <action
            id="com.aicoding.plugin.TogglePanelAction"
            class="com.aicoding.plugin.actions.TogglePanelAction"
            text="打开或关闭水豚 AI 助手"
            description="显示或隐藏水豚 AI 助手工具窗口">
            <add-to-group group-id="ToolsMenu" anchor="last" />
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl SLASH" />
        </action>

        <action
            id="com.aicoding.plugin.OpenCapybaraBrowserAction"
            class="com.aicoding.plugin.actions.OpenCapybaraBrowserAction"
            text="打开水豚浏览器"
            description="打开可被 OpenCode 控制的内置浏览器窗口">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>

        <group
            id="com.aicoding.plugin.AICodingMenu"
            text="水豚 AI 助手"
            description="将 IDEA 上下文发送给助手"
            popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first" />
            <add-to-group group-id="EditorTabPopupMenu" anchor="first" />
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first" />
            <action
                id="com.aicoding.plugin.AddToConversationAction"
                class="com.aicoding.plugin.actions.AddToConversationAction"
                text="加入对话"
                description="将选中的代码或文件加入对话" />
            <action
                id="com.aicoding.plugin.ExplainCodeAction"
                class="com.aicoding.plugin.actions.ExplainCodeAction"
                text="解释代码"
                description="将选中的代码加入解释任务" />
            <action
                id="com.aicoding.plugin.OptimizeCodeAction"
                class="com.aicoding.plugin.actions.OptimizeCodeAction"
                text="优化代码"
                description="将选中的代码加入优化任务" />
            <action
                id="com.aicoding.plugin.GenerateUnitTestsAction"
                class="com.aicoding.plugin.actions.GenerateUnitTestsAction"
                text="生成单元测试"
                description="为选中的代码生成单元测试" />
        </group>
    </actions>
</idea-plugin>
